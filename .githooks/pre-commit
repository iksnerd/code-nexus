#!/bin/sh
# Pre-commit gate. CI only runs on version tags, so this is what checks every
# commit. It covers the fast part of the pre-push checklist in CLAUDE.md; run
# the test suite yourself before pushing (it needs Qdrant and takes minutes).
#
# Install once per clone:  make hooks   (sets core.hooksPath=.githooks)
# Skip in an emergency:    git commit --no-verify
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Secret scan. CI runs gitleaks too, but only on tags, which is too late.
if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks (staged changes)"
  gitleaks git --pre-commit --staged --redact --no-banner
else
  echo "pre-commit: gitleaks not installed, skipping secret scan (brew install gitleaks)"
fi

elixir_files=$(printf '%s\n' "$staged" | grep -E '\.(ex|exs|heex)$' || true)
if [ -n "$elixir_files" ]; then
  echo "pre-commit: mix format --check-formatted"
  # Word splitting is intended: one argument per staged file.
  # shellcheck disable=SC2086
  mix format --check-formatted $elixir_files || {
    echo "pre-commit: run 'mix format', re-stage, and commit again"
    exit 1
  }
fi

if printf '%s\n' "$staged" | grep -qE '^(lib/|config/|mix\.exs$|mix\.lock$)'; then
  echo "pre-commit: mix compile --warnings-as-errors"
  mix compile --warnings-as-errors
fi
